{
  "name": "agent-trust-calibration",
  "description": "Dynamic trust calibration for autonomous agents: recency-weighted performance scoring, statistical drift detection, confidence-gated access policy, and a hash-chained audit ledger",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "agent-trust-calibration": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "tsc -p tsconfig.json",
    "cli": "bun src/cli.ts",
    "demo": "bun src/cli.ts demo"
  },
  "keywords": [
    "ai",
    "agents",
    "trust",
    "calibration",
    "drift-detection",
    "multi-agent",
    "scoring",
    "policy-engine",
    "audit-log",
    "autonomous-agents"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Retsumdk/agent-trust-calibration.git"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "bun-types": "^1.2.21",
    "typescript": "^5.9.3"
  }
}
